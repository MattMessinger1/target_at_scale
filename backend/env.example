# OpenAI API Key - for GPT-4o extraction and email generation
OPENAI_API_KEY=sk-...

# Firecrawl API Key - for website scraping (optional for V1)
FIRECRAWL_API_KEY=fc-...

# Perplexity API Key - for funding research
PERPLEXITY_API_KEY=pplx-...

# Database URL (SQLite for pilot, PostgreSQL for production)
DATABASE_URL=sqlite:///./wceps.db

# -----------------------------------------------------------------------------
# Production (Railway): persistence essentials
# -----------------------------------------------------------------------------
# In production you should use Railway Postgres (persistent) for KB rows:
# DATABASE_URL=<Railway Postgres plugin URL>
#
# Chroma embeddings MUST be persisted to a Railway Volume, otherwise they will be
# lost on each deploy (container filesystem is ephemeral).
# Recommended Railway Volume mount: /data
# CHROMA_PERSIST_DIR=/data/chroma_db

# Knowledge Base path
KB_PATH=../data/knowledge-base-export-2026-01-05.json
KB_PROCESSED_PATH=../data/processed/

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Production Settings (for Railway/Vercel deployment)
# Set this to your Vercel frontend URL
FRONTEND_URL=https://your-app.vercel.app

# Railway will set PORT automatically
# PORT=8000
